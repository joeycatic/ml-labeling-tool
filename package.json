{
  "name": "ml-labeling-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma migrate deploy",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "cross-env NEXT_TELEMETRY_DISABLED=1 eslint",
    "predev:e2e": "cross-env DATABASE_URL=file:./e2e.db prisma migrate deploy",
    "dev:e2e": "cross-env DATABASE_URL=file:./e2e.db NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3000",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:archive": "tsx scripts/db-archive.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:rollback-import": "tsx scripts/db-rollback-import.ts",
    "pretest": "cross-env DATABASE_URL=file:./test-vitest.db prisma migrate deploy",
    "pretest:e2e": "cross-env DATABASE_URL=file:./e2e.db prisma migrate deploy",
    "test": "cross-env DATABASE_URL=file:./test-vitest.db vitest run",
    "test:watch": "cross-env DATABASE_URL=file:./test-vitest.db vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/papaparse": "^5.5.2",
    "lucide-react": "^1.14.0",
    "mailparser": "^3.9.8",
    "next": "16.2.4",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@playwright/test": "^1.55.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
