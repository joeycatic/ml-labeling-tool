generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Email {
  id             Int      @id @default(autoincrement())
  messageId      String   @unique
  threadId       String?
  senderName     String?
  senderEmail    String
  recipientEmail String?
  subject        String   @default("")
  snippet        String   @default("")
  bodyText       String?
  bodyHtml       String?
  attachmentCount     Int      @default(0)
  attachmentNamesJson String?
  contentFingerprint  String?
  receivedAt     DateTime
  label          String?
  category       String?
  notes          String?
  labeledAt      DateTime?
  isLabeled      Boolean  @default(false)
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([label])
  @@index([isLabeled])
  @@index([receivedAt])
  @@index([senderEmail])
  @@index([messageId])
  @@index([category])
  @@index([isLabeled, receivedAt])
  @@index([contentFingerprint])
}

model ImportBatch {
  id               String @id @default(cuid())
  status           String @default("completed")
  sourceSurface    String
  fileCount        Int    @default(0)
  rowCount         Int    @default(0)
  createdCount     Int    @default(0)
  updatedCount     Int    @default(0)
  deletedCount     Int    @default(0)
  removedSeedCount Int    @default(0)
  createdAt        DateTime @default(now())

  events EmailChangeEvent[]
}

model EmailChangeEvent {
  id            String   @id @default(cuid())
  emailId        Int
  importBatchId  String?
  eventType      String
  sourceSurface  String
  changedFields  String
  beforeState    String?
  afterState     String?
  labelChanged   Boolean  @default(false)
  emailSubject   String?
  senderEmail    String?
  label          String?
  category       String?
  createdAt      DateTime @default(now())

  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([emailId, createdAt])
  @@index([importBatchId, createdAt])
  @@index([labelChanged, createdAt])
}
